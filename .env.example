# Victron MQTT
VICTRON_MQTT_URL=tcp://your-victron-ip:1883
VICTRON_DEVICE_ID=your-device-id

# Victron VRM
VICTRON_VRM_TOKEN=your-vrm-token
VICTRON_VRM_SITE_ID=your-site-id

# Inexogy (optional)
INEXOGY_EMAIL=your-email
INEXOGY_PASSWORD=your-password
INEXOGY_METER_ID=your-meter-id

# MPPT Temperature Sensor (optional, Shelly device)
MPPT_TEMPERATURE_URL=http://your-shelly-ip/rpc/Temperature.GetStatus?id=101

# Deploy target (optional)
DEPLOY_SERVER=root@your-server-ip

# Defaults (overridable via API)
BATTERY_CAPACITY_KWH=16
MIN_SOC_PERCENT=20
TARGET_SOC_PERCENT=100
MAX_AC_POWER_W=12000
WINTER_MODE_THRESHOLD_FACTOR=1.2
REGULATION_INTERVAL_MS=20000
LARGE_CHANGE_THRESHOLD_W=3000
DEADBAND_W=1500
